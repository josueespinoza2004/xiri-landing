# Plantilla de variables de entorno de la landing de Xiri.
# Copiá este archivo a ".env" y ajustá los valores según tu entorno.

# === Backend (solo servidor, no se expone al cliente) ===
# URL base de la API pública de Xiri usada por los Server Components.
XIRI_API_URL=https://xiri-backend-production.onrender.com/api

# === Descarga del APK (expuestas al cliente con prefijo NEXT_PUBLIC_) ===
# URL directa al APK alojado en GitHub Releases (tag "latest").
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://github.com/<usuario>/<repo>/releases/download/latest/Xiri.apk
# Nombre con el que se guarda el archivo al descargarlo.
NEXT_PUBLIC_APK_FILE_NAME=Xiri.apk
# Versión pública mostrada en la UI de descarga.
NEXT_PUBLIC_APP_VERSION=1.0.0
